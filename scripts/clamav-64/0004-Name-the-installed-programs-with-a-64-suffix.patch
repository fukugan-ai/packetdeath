From 1255fb16927f8905a8c1dbf88715d58e430ccfbc Mon Sep 17 00:00:00 2001
From: packetdeath <packetdeath@localhost>
Date: Sun, 4 Oct 2026 07:23:47 +0900
Subject: [PATCH 4/4] Name the installed programs with a 64 suffix

The 64-bit build installs next to the stock one under its own prefix;
a 64 suffix on every program keeps the two from being mistaken for
each other. Libraries and man pages keep their names.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 clambc/CMakeLists.txt     | 1 +
 clamconf/CMakeLists.txt   | 1 +
 clamd/CMakeLists.txt      | 1 +
 clamdscan/CMakeLists.txt  | 1 +
 clamdtop/CMakeLists.txt   | 1 +
 clamscan/CMakeLists.txt   | 1 +
 clamsubmit/CMakeLists.txt | 1 +
 freshclam/CMakeLists.txt  | 4 ++--
 sigtool/CMakeLists.txt    | 1 +
 9 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/clambc/CMakeLists.txt b/clambc/CMakeLists.txt
index 445c684..84f29c3 100644
--- a/clambc/CMakeLists.txt
+++ b/clambc/CMakeLists.txt
@@ -24,6 +24,7 @@ target_include_directories( clambc
     PRIVATE ${CMAKE_BINARY_DIR} # For clamav-config.h
 )
 set_target_properties( clambc PROPERTIES COMPILE_FLAGS "${WARNCFLAGS}" )
+set_target_properties( clambc PROPERTIES OUTPUT_NAME clambc64 )
 
 if (APPLE AND CLAMAV_SIGN_FILE)
     set_target_properties( clambc PROPERTIES
